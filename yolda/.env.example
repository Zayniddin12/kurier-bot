BOT_API_KEY=           # uzun tasodifiy qator: openssl rand -hex 24 (bot va backend uchun umumiy)
BOT_TOKEN=             # @BotFather dan
ADMIN_EMAIL=admin@yolda.uz           # birinchi ishga tushishda yaratiladigan administrator
ADMIN_PASSWORD=                      # kamida 12 belgi
PANEL_HOST=panel.2-31-28-150.sslip.io   # panel domeni (HTTPS avtomatik)
API_HOST=yolda-api.2-31-28-150.sslip.io       # restoranlar shu manzilga zakaz yuboradi
CORS_ORIGINS=https://panel.2-31-28-150.sslip.io   # PANEL_HOST bilan bir xil, https:// bilan
