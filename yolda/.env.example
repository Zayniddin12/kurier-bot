# cp .env.example .env  — keyin qiymatlarni to'ldiring
SECRET_KEY=            # uzun tasodifiy qator: openssl rand -hex 32
BOT_API_KEY=           # uzun tasodifiy qator: openssl rand -hex 24 (bot va backend uchun umumiy)
BOT_TOKEN=             # @BotFather dan
ADMIN_EMAIL=admin@yolda.uz           # birinchi ishga tushishda yaratiladigan administrator
ADMIN_PASSWORD=                      # kamida 12 belgi
CORS_ORIGINS=http://localhost:8080   # panel domeni (https://panel.sizning-domen.uz)
# SEED_DEMO=false      # true: demo ma'lumot va demo loginlar (faqat sinov uchun!)
# DEMO_SIMULATION=false
